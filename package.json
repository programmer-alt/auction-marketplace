{
  "name": "auction-marketplace",
  "version": "1.0.0",
  "description": "Full-stack auction marketplace with React, Node.js, Prisma, and Stripe",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue,bgGreen\" --names \"backend,frontend\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "test": "npm run test --prefix backend",
    "test:watch": "npm run test:watch --prefix backend"
  },
  "keywords": [
    "auction",
    "marketplace",
    "react",
    "nodejs",
    "prisma",
    "stripe"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
