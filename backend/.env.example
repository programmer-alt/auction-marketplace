# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/auction_marketplace?schema=public"

# Redis
REDIS_URL="redis://default:your-password@your-redis-host:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Stripe (test keys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Frontend
FRONTEND_URL="http://localhost:5173"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# CSRF
CSRF_SECRET="your-csrf-secret-key-change-in-production"
